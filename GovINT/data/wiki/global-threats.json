  "meta": {
    "title": "Global Threat Tracker — Designations, Crime, Drugs & Conflict",
    "purpose": "Open-source aggregation of OFFICIAL designations, published threat assessments, and academic conflict datasets for education and research.",
    "scope_note": "Aggregate, structural, and analytical public data only. Does NOT track the physical location or movements of individuals, provide operational trafficking routes, or facilitate contact with any group. Live OFAC designations are written to data/latest/global_designations.json.",
    "reliability_caveat": "Designations are official; assessments/datasets from NGOs and academia are labeled accordingly."
  },

